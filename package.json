{
  "name": "speechdeck",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test",
    "publish:jsr": "node scripts/publish-jsr.mjs",
    "bump": "node scripts/bump.ts",
    "readyrun": "node scripts/readyrun.mjs"
  },
  "dependencies": {
    "@readyrun/readyrun": "jsr:^0.1.5"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "^26.3.0",
    "eslint-plugin-solid": "^0.16.0",
    "happy-dom": "^20.13.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "solid-js": "^1.9.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0"
}
